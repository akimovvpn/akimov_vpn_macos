{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akimov vpn",
  "version": "1.0.18",
  "identifier": "vpn.akimov.macos",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "\u0430\u043a\u0438\u043c\u043e\u0432 vpn",
        "width": 1060,
        "height": 700,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#07070A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "core/mihomo": "core/mihomo",
      "core/manifest.json": "core/manifest.json",
      "core/geoip.metadb": "core/geoip.metadb",
      "core/GeoSite.dat": "core/GeoSite.dat",
      "../licenses/": "licenses/",
      "../ui/fonts/Martian-Mono-OFL.txt": "licenses/Martian-Mono-OFL.txt",
      "../core-patches/": "core-patches/",
      "../build-core.sh": "build-core.sh",
      "../README.md": "README.md",
      "../uninstall-helper.sh": "uninstall-helper.sh",
      "../TELEGRAM_LOGIN.md": "TELEGRAM_LOGIN.md"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}
